# Copia este archivo como .env y configura las variables de tu servidor en BanaHosting cPanel
PORT=3001
NODE_ENV=production
JWT_SECRET=cambia_este_secreto_por_uno_seguro_en_produccion

# Configuración PostgreSQL en cPanel de BanaHosting
# Nota: En BanaHosting, tanto el usuario como la base de datos llevan el prefijo de tu cuenta cPanel (ej: micuenta_romadb)
DATABASE_URL=postgresql://micuenta_usuario:tu_contraseña@localhost:5432/micuenta_romadb

# =============================================================================
# INTEGRACIÓN GOOGLE DRIVE CENTRAL (Subidas de alta velocidad 300MB - 1GB+)
# =============================================================================
# Opción 1: Google Service Account (Recomendado)
# Coloca el JSON completo en una sola línea o configura las variables individuales:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=agencia-drive@mi-proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Opción 2: OAuth 2.0 Central con Refresh Token
# GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=tu_cliente_secret
# GOOGLE_REFRESH_TOKEN=tu_refresh_token

# ID de la carpeta raíz de Google Drive donde se crearán las subcarpetas del sistema
# (El ID es la cadena al final de la URL en drive.google.com/drive/folders/ESTE_ID)
# GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
